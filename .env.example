# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# ── Database (standard PostgreSQL connection string) ─────────────────────
DATABASE_URL=postgresql://user:password@host:5432/surveypro

# ── Sessions / Auth ───────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── File storage: local | cloudinary | s3 ─────────────────────────────────
STORAGE_PROVIDER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Get an API key at https://resend.com/api-keys
# Without a verified domain use onboarding@resend.dev as the sender
# (delivers only to your own Resend account email).
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="SurveyPro <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL=admin@example.com
